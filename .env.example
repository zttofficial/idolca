# 複製成 .env.local 再填。NEXT_PUBLIC_ 開頭的會打包進前端，只放公開資訊。

# devnet 或 mainnet-beta，默認 devnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# 瀏覽器端 RPC；留空用 Solana 官方公共端點。生產環境用按網域限制來源的服務商端點
NEXT_PUBLIC_SOLANA_RPC_URL=
# devnet 結算測試幣；留空用 Circle 的 devnet USDC。主網固定用官方 USDT
NEXT_PUBLIC_USDT_MINT=
# 網站公開網址，NFT 元數據和圖片指向這裡；留空用 https://idolca.vercel.app
NEXT_PUBLIC_SITE_URL=
# 掛單託管程序地址；留空用 src/lib/chain/devnet.json 裡的
NEXT_PUBLIC_MARKET_PROGRAM_ID=

# 以下只在伺服器和腳本裡使用
# Postgres 連線字串（Neon）；留空時本機開發用 PGlite，資料存在 .data/
DATABASE_URL=
# 管理接口令牌：把自由上鏈的卡標成假卡（PATCH /api/admin/items/{id}），留空時接口關閉
ADMIN_TOKEN=
# Helius API 金鑰：金庫頁讀取鏈上集合
HELIUS_API_KEY=
# 平台腳本用的 RPC；留空用官方公共端點
SOLANA_RPC_URL=
# 平台錢包金鑰（Solana CLI 格式，64 個數字的 JSON 陣列），負責鑄造、標假卡、提貨的凍結和銷毀。
# 線上把陣列本身放進 PLATFORM_SECRET_KEY；本機也可以用 PLATFORM_KEYPAIR 指向金鑰檔（例如 .data/platform-devnet.json）
PLATFORM_SECRET_KEY=
PLATFORM_KEYPAIR=
