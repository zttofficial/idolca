# 複製成 .env.local 再填。NEXT_PUBLIC_ 開頭的會打包進前端，只放公開資訊。

# devnet 或 mainnet-beta，默認 devnet。決定讀哪一份 src/lib/chain/<cluster>.json，換網路只改這裡
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# 網站公開網址，NFT 元數據和圖片指向這裡；留空用 https://idolca.trade
NEXT_PUBLIC_SITE_URL=
# 服務條款和隱私權政策上的聯絡郵箱；留空時不顯示
NEXT_PUBLIC_CONTACT_EMAIL=
# 兩個金庫的收件地址（多行），用戶把自己上鏈的卡寄進金庫時列出來選（見 src/lib/vaults.ts）；留空的顯示「尚未公布」
NEXT_PUBLIC_VAULT_ADDRESS_YVR=
NEXT_PUBLIC_VAULT_ADDRESS_CKG=
# Arc 收款通道（見 docs/arc.md）：testnet 或 mainnet；留空時只有 Solana 付款。平台收款地址寫在 src/lib/chain/arc-<網路>.json
NEXT_PUBLIC_ARC_NETWORK=
# Privy 的 App ID（公開的）：收藏錢包（不懂加密的粉絲在 Idolca 建的嵌入式錢包）和刷卡加值。留空時不提供收藏錢包，只能綁定自己的錢包。
# Privy 後台的 Allowed origins 要加上網站網域；本機開發用另一個 Privy 應用（它的 Allowed origins 加 http://localhost:3000）
NEXT_PUBLIC_PRIVY_APP_ID=
# 卡包返還率上限（剩下卡池的期望價值 ÷ 售價），超過就暫停販售；留空為 0.8
NEXT_PUBLIC_PACK_MAX_RTP=

# 以下只在伺服器和腳本裡使用
# Postgres 連線字串（Neon）；留空時本機開發用 PGlite，資料存在 .data/。每個網路用自己的資料庫
DATABASE_URL=
# 寄信（驗證信箱、重設密碼）用 Resend 的 API 金鑰；寄件網域要先在 Resend 驗證。留空時本機把信寫進 .data/outbox.jsonl，正式環境寄信會失敗
RESEND_API_KEY=
# 寄件人；留空為 Idolca <noreply@idolca.trade>
EMAIL_FROM=
# 管理員錢包（逗號分隔）。也可以用 npm run admin:grant -- <郵箱或錢包> 在資料庫裡授予
ADMIN_WALLETS=
# Vercel Cron 呼叫 /api/cron/daily 時帶的密鑰；留空時排程接口關閉，逾時訂單只在用戶打開訂單列表時處理
CRON_SECRET=
# 不開放盲盒卡包的國家（ISO 代碼，逗號分隔）；留空為 BE,NL
PACKS_BLOCKED_COUNTRIES=
# 伺服器端 RPC；留空用官方公共端點。主網用付費 RPC
SOLANA_RPC_URL=
# 平台錢包金鑰（Solana CLI 格式，64 個數字的 JSON 陣列）：鑄造、收付款、轉移 NFT、提貨的凍結和銷毀。
# 線上把陣列本身放進 PLATFORM_SECRET_KEY；本機也可以用 PLATFORM_KEYPAIR 指向金鑰檔（例如 .data/platform-devnet.json）
PLATFORM_SECRET_KEY=
PLATFORM_KEYPAIR=
# 託管程序初始化時的抽成收款錢包（npm run chain:setup-market）；主網必填，用冷錢包
TREASURY_ADDRESS=
# Arc 平台熱錢包私鑰（0x 開頭），收款時代送買家的授權轉帳、付手續費，也用來退款；地址要和 arc-<網路>.json 的 platform 一致。
# 線上放進 ARC_PLATFORM_KEY；本機也可以用 ARC_PLATFORM_KEYFILE 指向 {"privateKey": "0x…"} 的檔案（例如 .data/arc-platform-testnet.json）
ARC_PLATFORM_KEY=
ARC_PLATFORM_KEYFILE=
# Arc 伺服器端 RPC；留空用 Arc 官方公共端點
ARC_RPC_URL=
# 設成 1 時只有管理員能用 Arc 付款（Arc 主網收真錢、Solana 那邊還是 devnet 樣本卡的展示環境）
ARC_PAY_ADMIN_ONLY=

# 產品分析（PostHog）的專案金鑰（phc_ 開頭，公開的）；留空不啟用。只在正式環境設，本機和預覽部署留空，測試流量才不會混進數據
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog 的接收位址；留空用歐盟機房 https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=

# 端到端測試（e2e/）
# 管理員錢包金鑰檔，地址要在 ADMIN_WALLETS 裡；留空用 .data/admin-test-devnet.json
E2E_ADMIN_KEYPAIR=
# 測試的網站網址；留空用 http://localhost:3000
E2E_BASE_URL=
# Arc 端到端測試的買家金鑰檔（裡面要有測試網 USDC）；留空用 .data/arc-buyer-testnet.json
E2E_ARC_BUYER=
# 縮短期限，只在跑端到端測試的網站上設，正式環境留空：
# 擔保交易的寄出、確認期限（天，可用小數）；拍賣的一「天」、出價付款期限、截止前的延長時間（秒）
ESCROW_SHIP_DAYS=
ESCROW_CONFIRM_DAYS=
AUCTION_DAY_SECONDS=
AUCTION_BID_WINDOW_SECONDS=
AUCTION_EXTEND_SECONDS=
